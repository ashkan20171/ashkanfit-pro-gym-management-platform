<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Json is the safe default. Change to SqlServer after creating the database. -->
    <add key="StorageProvider" value="Json" />
  </appSettings>
  <connectionStrings>
    <add name="AshkanFitPro" providerName="System.Data.SqlClient" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=AshkanFitPro;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10" />
  </connectionStrings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
</configuration>
